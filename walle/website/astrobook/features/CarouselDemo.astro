---
// Story-only wrapper: Astrobook passes props, not slots, so this component
// provides sample slides for the Carousel stories.
import Carousel from "@walle/components/features/Carousel.astro";

interface Props {
  label?: string;
  perView?: 1 | 2 | 3 | 4;
  controls?: boolean;
  counter?: boolean;
  slides?: number;
  images?: boolean;
  zoom?: boolean;
  fit?: "uniform" | "auto";
}

const {
  label = "Demo carousel",
  perView = 1,
  controls = true,
  counter = false,
  slides = 5,
  images = false,
  zoom = false,
  fit = "uniform",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sampleImages = [`${base}/img/blog-demo-1.jpg`, `${base}/img/blog-demo-2.jpg`];
---

{
  images ? (
    <Carousel
      label={label}
      perView={perView}
      controls={controls}
      counter={counter}
      zoom={zoom}
      fit={fit}
    >
      {sampleImages.map((src, i) => (
        <div class="demo-image">
          <img src={src} alt={`Sample slide ${i + 1}`} width="1200" height="800" loading="lazy" />
        </div>
      ))}
    </Carousel>
  ) : (
    <Carousel label={label} perView={perView} controls={controls} counter={counter}>
      {Array.from({ length: slides }, (_, i) => (
        <div class="demo-slide">Slide {i + 1}</div>
      ))}
    </Carousel>
  )
}

<style>
  .demo-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    background: var(--surface-alt, #f5f5f5);
    border: 1px solid var(--border, #d1d5db);
    border-radius: var(--radius-lg, 0.375rem);
    font-size: 1.25rem;
    font-weight: 600;
  }
</style>
