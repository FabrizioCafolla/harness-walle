---
// Story-only wrapper: overrides Button's --button-bg from a site layer and unlayered.
// `is:global` is required: a scoped selector carries this file's data-astro-cid and never
// matches Button's DOM.
import Button from "@walle/components/elements/Button.astro";
---

<Button text="Site-layer override" class="override-site-target" />
<Button text="Unlayered override" class="override-unlayered-target" />

<style is:global>
  /* `site` is the last layer, so it beats Button's `.button` at equal specificity. */
  @layer site {
    .override-site-target {
      --button-bg: #660066;
    }
  }

  /* Unlayered rules rank above every layered rule. */
  .override-unlayered-target {
    --button-bg: #006666;
  }
</style>
