{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://walle.dev/schemas/app.schema.json",
  "title": "Walle app config (src/configs/app.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "website": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "favicon": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "robots": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "titleMaxLength": {
          "type": "integer",
          "minimum": 20,
          "maximum": 9007199254740991
        },
        "descriptionMaxLength": {
          "type": "integer",
          "minimum": 50,
          "maximum": 9007199254740991
        }
      },
      "required": ["title", "description"],
      "additionalProperties": false
    },
    "astro": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "basePath": {
          "type": "string"
        },
        "trailingSlash": {
          "type": "string",
          "enum": ["always", "never", "ignore"]
        },
        "analyticsScriptContent": {
          "type": "string"
        },
        "sitemapExclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapter": {
          "type": "string",
          "enum": ["node"]
        },
        "ssr": {}
      },
      "required": ["baseUrl", "basePath"],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "pwa": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "shortName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "themeColor": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "enum": ["standalone", "fullscreen", "minimal-ui", "browser"]
        },
        "startUrl": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "sizes": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": ["src", "sizes"],
            "additionalProperties": false
          }
        },
        "appleTouchIcon": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "commerce": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "off",
          "type": "string",
          "enum": ["off", "catalog", "shop"]
        },
        "cartInNavbar": {
          "type": "boolean"
        },
        "showAddToCartOnCards": {
          "type": "boolean"
        },
        "showBuyButton": {},
        "locale": {},
        "addToCartLabel": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["website", "astro"],
  "additionalProperties": false
}
