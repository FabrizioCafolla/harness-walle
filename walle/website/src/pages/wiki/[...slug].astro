---
import { getCollection, render } from "astro:content";
import { BaseLayout } from "@walle/layouts";
import { resolveInternalUrl } from "@walle/utils";
import { groupPages, rewriteLinks, titleOf } from "./_wiki";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Wiki files link each other with relative `.md` paths, correct in the repo but not as routes:
// rewrite them to /wiki pages, or to the file on GitHub when they leave the wiki folder.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const wikiEntries = await getCollection("wiki");
const wikiIds = new Set(wikiEntries.map((e) => e.id));
// `rendered` is populated at build but isn't on the public CollectionEntry type.
const html = (entry as { rendered?: { html?: string } }).rendered?.html;
const sections = groupPages(wikiEntries);
const title = titleOf(entry);
---

<BaseLayout headerTitle={title} headerDescription="Walle design-system documentation">
  <div class="wiki-page">
    <nav class="wiki-nav" aria-label="Wiki pages">
      <a href={resolveInternalUrl("/wiki")}>All pages</a>
      {
        sections.map((section) => (
          <>
            <h2 class="wiki-nav__section">{section.title}</h2>
            <ul>
              {section.pages.map((p) => (
                <li>
                  <a
                    href={resolveInternalUrl(`/wiki/${p.id}`)}
                    aria-current={p.id === entry.id ? "page" : undefined}
                  >
                    {p.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </nav>
    <article class="wiki-content">
      {html ? <Fragment set:html={rewriteLinks(html, entry.id, wikiIds, base)} /> : <Content />}
    </article>
  </div>
</BaseLayout>

<style>
  .wiki-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 60rem) {
    .wiki-page {
      grid-template-columns: 14rem 1fr;
    }
    .wiki-nav {
      position: sticky;
      top: 1rem;
      align-self: start;
    }
  }
  .wiki-nav ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.35rem;
  }
  .wiki-nav__section {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .wiki-nav [aria-current="page"] {
    font-weight: 700;
  }
  /* Readable measure for prose; wide blocks (code, tables) scroll instead of overflowing. */
  .wiki-content {
    max-width: 72ch;
    min-width: 0;
    line-height: 1.7;
  }
  .wiki-content :global(pre) {
    overflow-x: auto;
  }
  .wiki-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .wiki-content :global(img) {
    max-width: 100%;
    height: auto;
  }
  .wiki-content :global(a) {
    text-decoration: underline;
  }
</style>
