---
import { getCollection } from "astro:content";
import { BaseLayout } from "@walle/layouts";
import { resolveInternalUrl } from "@walle/utils";
import { groupPages } from "./_wiki";

const sections = groupPages(await getCollection("wiki"));
---

<BaseLayout
  headerTitle="Wiki"
  headerDescription="The Walle design-system documentation, rendered from the repo wiki at build time."
>
  {
    sections.length === 0 ? (
      <p>No wiki pages found.</p>
    ) : (
      <div class="wiki-index">
        {sections.map((section) => (
          <section aria-labelledby={`wiki-${section.id}`}>
            <h2 id={`wiki-${section.id}`}>{section.title}</h2>
            <ul>
              {section.pages.map((p) => (
                <li>
                  <a href={resolveInternalUrl(`/wiki/${p.id}`)}>{p.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .wiki-index {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1rem;
    display: grid;
    gap: 2rem;
  }
  .wiki-index ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .wiki-index a {
    font-size: 1.125rem;
  }
</style>
