{
  "$schema": "../../walle/schemas/app.schema.json",
  "website": {
    "title": "Walle",
    "description": "Design System",
    "favicon": "/images/profile.jpeg",
    "image": "/images/banner.png",
    "robots": "index, follow",
    "language": "en-US"
  },
  "astro": {
    "baseUrl": "https://fabriziocafolla.github.io",
    "basePath": "/harness-walle",
    "trailingSlash": "never",
    "analyticsScriptContent": "",
    "redirects": {
      "/products/example": "/products/aurora-merino-overshirt",
      "/products/example-2": "/products/cirrus-packable-jacket"
    }
  },
  "commerce": {
    "mode": "shop",
    "cartInNavbar": true,
    "showAddToCartOnCards": true
  },
  "seo": {
    "ogImage": {
      "enabled": true,
      "collections": ["posts"]
    }
  }
}
