---
import NavbarMenu from "./NavbarMenu.astro";
import type { NavbarConfig } from "@walle/config";
import { label as t, resolveInternalUrl } from "@walle/utils";
import type { BaseProps } from "../../shared/types";
import { splitProps } from "../../shared/attrs";

export interface Props extends BaseProps<"header"> {
  config: NavbarConfig;
}

const OWN_KEYS = ["config", "class"] as const;
const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const { config, class: className } = own;
const navId = `nav-${Math.random().toString(36).substring(2, 9)}`;

const hasLogo = config.logo?.src;
const hasTitle = config.logo?.title;
const shouldShowBrand = hasLogo || hasTitle;
---

<header class:list={["site-header", className]} {...rest}>
  <div class="container">
    <nav class="main-nav" aria-label={t("nav.main")} data-component="Navbar" data-nav-root="true">
      <slot name="brand">
        {
          shouldShowBrand && (
            <div class="brand-container">
              <a
                href={resolveInternalUrl(config.logo?.url || "/")}
                title={config.logo?.title || t("breadcrumbs.home")}
                class="brand-link"
              >
                {hasLogo ? (
                  <>
                    <img
                      src={config.logo.src}
                      alt={config.logo.alt || config.logo.title || t("logo")}
                      aria-label={config.logo.alt || config.logo.title || t("logo")}
                      width={config.logo.width || 50}
                      height={config.logo.height || 50}
                      loading="eager"
                      class:list={["brand-logo", config.logo.cssClasses]}
                      fetchpriority="high"
                    />
                    {config.logo.srcInverse && (
                      <img
                        src={config.logo.srcInverse}
                        alt=""
                        aria-hidden="true"
                        width={config.logo.width || 50}
                        height={config.logo.height || 50}
                        loading="eager"
                        class:list={["brand-logo", "brand-logo--inverse", config.logo.cssClasses]}
                      />
                    )}
                  </>
                ) : hasTitle ? (
                  <span class:list={["brand-title", config.logo.cssClasses]}>
                    {config.logo.title}
                  </span>
                ) : null}
              </a>
            </div>
          )
        }
      </slot>

      <NavbarMenu items={config.items || []} navId={navId} />

      <slot name="actions" />

      {
        /* Last in the DOM so on mobile the reading/focus order matches the visual order
          (brand · cart · hamburger) without CSS `order` reshuffling the tab sequence. */
      }
      <button
        id="mobile-menu-toggle"
        class="hamburger"
        aria-controls={navId}
        aria-expanded="false"
        aria-label={t("nav.toggle")}
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </nav>
  </div>
</header>

<style is:global>
  @layer walle.components {
    /* On :root, not on the header: the element under a transparent menu pads its top with it. */
    :root {
      --navbar-height: 70px;
    }

    .site-header {
      /* Public properties */
      --navbar-bg: color-mix(in srgb, var(--surface) 95%, transparent);
      --navbar-fg: var(--text);
      --navbar-border: color-mix(in srgb, var(--text) 8%, transparent);
      --navbar-shadow: var(--shadow-md);
      --navbar-backdrop: blur(20px);
      --navbar-logo-height: 40px;
      --navbar-logo-height-mobile: 34px;
      --navbar-link-color: var(--navbar-fg);
      --navbar-link-color-hover: var(--primary);
      --navbar-link-active-color: var(--navbar-link-color);
      --navbar-link-active-bg: transparent;
      --navbar-link-radius: var(--radius-md);
      /* Top state of a page that opts in with a `data-navbar-overlay` element (see below). */
      --navbar-overlay-fg: var(--white);
      --navbar-overlay-link-active-bg: color-mix(in srgb, var(--white) 16%, transparent);
      --navbar-overlay-button-bg: var(--white);
      --navbar-overlay-button-fg: var(--secondary);
      --navbar-overlay-button-border: var(--navbar-overlay-button-bg);
      --navbar-overlay-button-bg-hover: color-mix(
        in srgb,
        var(--navbar-overlay-button-bg) 88%,
        var(--black)
      );
      --navbar-mobile-bg: var(--surface);
      --navbar-mobile-divider: 1px solid var(--navbar-border);
      --navbar-mobile-link-padding: 1.25rem 0.5rem;
      --navbar-mobile-link-padding-narrow: 1.125rem 0.25rem;
      --navbar-mobile-link-radius: 0;
      --navbar-hamburger-bg-hover: color-mix(in srgb, var(--primary) 8%, transparent);
      --navbar-dropdown-bg: var(--surface);
      --navbar-dropdown-radius: var(--radius-lg);

      /* Effective values of the link and control colors. Components read these; the overlay top
         state swaps them, so a site's own `--navbar-*` (set in a later layer) cannot undo it. */
      --_navbar-fg: var(--navbar-fg);
      --_navbar-link-color: var(--navbar-link-color);
      --_navbar-link-color-hover: var(--navbar-link-color-hover);
      --_navbar-link-active-color: var(--navbar-link-active-color);
      --_navbar-link-active-bg: var(--navbar-link-active-bg);

      position: sticky;
      top: 0;
      width: 100%;
      background: var(--navbar-bg);
      -webkit-backdrop-filter: var(--navbar-backdrop);
      backdrop-filter: var(--navbar-backdrop);
      border-bottom: 1px solid var(--navbar-border);
      z-index: 1000;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .site-header.scrolled {
      --navbar-bg: color-mix(in srgb, var(--surface) 98%, transparent);
      --navbar-border: color-mix(in srgb, var(--text) 12%, transparent);
      background: var(--navbar-bg);
      border-bottom-color: var(--navbar-border);
      box-shadow: var(--navbar-shadow);
    }

    .site-header .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .main-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--navbar-height);
      position: relative;
    }

    .brand-container {
      display: flex;
      align-items: center;
      z-index: 100;
      flex-shrink: 0;
    }

    .brand-link {
      display: flex;
      align-items: center;
      text-decoration: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .brand-link:focus {
      box-shadow: none;
    }

    /* Text logo: a wordmark, not a section heading (kept out of the heading outline).
           `.brand-title` is the tuning knob for its size. */
    .brand-link .brand-title {
      display: inline-block;
      margin: 0;
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--primary);
    }

    /* Image logo: constrained by height (SVGs often lack intrinsic dimensions), width
       follows; consumers override via the logo `cssClasses`. */
    .brand-link .brand-logo {
      display: block;
      height: var(--navbar-logo-height);
      width: auto;
      max-width: 180px;
      object-fit: contain;
    }

    @media (max-width: 480px) {
      .brand-link .brand-title {
        font-size: 1.2rem;
      }
      .brand-link .brand-logo {
        height: var(--navbar-logo-height-mobile);
      }
    }

    .nav-container {
      display: flex;
      align-items: center;
      margin-left: auto;
    }

    .nav-links {
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: 0.5rem;
      align-items: center;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      color: var(--_navbar-link-color);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      border-radius: var(--navbar-link-radius);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      letter-spacing: -0.01em;
    }

    .nav-link:focus,
    .nav-link:active {
      box-shadow: none;
      border: none;
    }

    @media (min-width: 769px) {
      .nav-link::after {
        content: "";
        position: absolute;
        bottom: 6px;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--_navbar-link-color-hover);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(-50%);
        border-radius: var(--radius-sm);
      }

      .nav-link:hover::after {
        width: calc(100% - 2.5rem);
      }

      .nav-link:hover {
        color: var(--_navbar-link-color-hover);
        transform: translateY(-1px);
      }
    }

    .dropdown-trigger .dropdown-arrow {
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      margin-left: 0.25rem;
      opacity: 0.7;
    }

    .nav-item.has-dropdown:hover .dropdown-trigger .dropdown-arrow,
    .nav-item.has-dropdown.active .dropdown-trigger .dropdown-arrow {
      transform: rotate(180deg);
      opacity: 1;
    }

    .dropdown-container {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      top: calc(100% + 12px);
      left: 50%;
      transform: translateX(-50%) translateY(-8px) scale(0.95);
      min-width: 160px;
      width: max-content;
      max-width: min(calc(100vw - 2rem), 520px);
      background: var(--navbar-dropdown-bg);
      border-radius: var(--navbar-dropdown-radius);
      box-shadow: var(--shadow-lg);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 1000;
      list-style: none;
      margin: 0;
      padding: 12px;
      border: 1px solid var(--border);
      box-sizing: border-box;
      overflow-wrap: anywhere;
    }

    .nav-item.has-dropdown:hover .dropdown-menu,
    .nav-item.has-dropdown.active .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0) scale(1);
    }

    .dropdown-item {
      position: relative;
    }

    .dropdown-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.875rem 1.25rem;
      color: var(--navbar-link-color);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      width: 100%;
      text-align: left;
      border-radius: var(--radius-md);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      letter-spacing: -0.01em;
    }

    .dropdown-link:hover,
    .dropdown-link:focus {
      color: var(--navbar-link-color-hover);
      transform: translateX(4px);
      box-shadow: none;
    }

    /* Keyboard focus stays visible on every navbar link. */
    .brand-link:focus-visible,
    .nav-link:focus-visible,
    .dropdown-link:focus-visible {
      outline: 3px solid var(--focus-ring);
      outline-offset: 2px;
    }

    .hamburger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 10px;
      z-index: 100;
      width: 48px;
      height: 48px;
      justify-content: center;
      align-items: center;
      position: relative;
      border-radius: var(--radius-md);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hamburger:hover {
      background-color: var(--navbar-hamburger-bg-hover);
    }

    .hamburger-line {
      display: block;
      width: 24px;
      height: 2px;
      background-color: var(--_navbar-fg);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: absolute;
      border-radius: var(--radius-sm);
    }

    .hamburger-line:nth-child(1) {
      transform: translateY(-6px);
    }
    .hamburger-line:nth-child(2) {
      transform: translateY(0);
    }
    .hamburger-line:nth-child(3) {
      transform: translateY(6px);
    }

    .hamburger.active .hamburger-line:nth-child(1) {
      transform: rotate(45deg);
    }
    .hamburger.active .hamburger-line:nth-child(2) {
      opacity: 0;
      transform: scale(0);
    }
    .hamburger.active .hamburger-line:nth-child(3) {
      transform: rotate(-45deg);
    }

    @media (max-width: 768px) {
      .site-header .container {
        padding: 0 1rem;
      }

      :root {
        --navbar-height: 64px;
      }

      /* Mobile: `margin-left: auto` pushes cart + hamburger right; DOM order already matches
         visual order (brand · cart · hamburger), so no CSS `order` is needed. */
      .hamburger {
        display: flex;
        margin-left: 0.5rem;
      }

      .cart-badge--inline {
        margin-left: auto;
      }

      .nav-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        /* Opaque on purpose: the header above has its own `backdrop-filter`, which isolates
           this fixed panel, so a translucent fill here lets the page text show through. */
        background: var(--navbar-mobile-bg);
        visibility: hidden;
        opacity: 0;
        transform: scale(0.95);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: stretch;
        padding: 80px 0 40px 0;
        z-index: 90;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        box-sizing: border-box;
      }

      .nav-container.show {
        visibility: visible;
        opacity: 1;
        transform: scale(1);
      }

      .nav-links {
        flex-direction: column;
        width: 100%;
        gap: 8px;
        padding: 0 1.5rem;
        align-items: stretch;
        box-sizing: border-box;
      }

      .nav-item {
        width: 100%;
        border-bottom: var(--navbar-mobile-divider);
        box-sizing: border-box;
      }

      .nav-item:last-child {
        border-bottom: none;
      }

      .nav-item--button {
        border-bottom: none;
        padding: 1rem 0;
      }

      .nav-item--button .button {
        width: 100%;
      }

      .nav-link {
        padding: var(--navbar-mobile-link-padding);
        font-size: 1.1rem;
        font-weight: 400;
        border-radius: var(--navbar-mobile-link-radius);
        background: transparent;
        letter-spacing: -0.02em;
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
      }

      .nav-link:hover {
        background: transparent;
        color: var(--navbar-link-color-hover);
        transform: none;
      }

      .nav-link::after {
        display: none;
      }

      .dropdown-trigger .dropdown-arrow {
        opacity: 0.5;
        margin-left: auto;
      }

      .nav-item:not(.active) .dropdown-trigger {
        color: var(--navbar-link-color);
        background: transparent;
      }

      .nav-item:not(.active) .dropdown-trigger .dropdown-arrow {
        transform: rotate(0deg);
        opacity: 0.5;
      }

      .dropdown-trigger:hover,
      .dropdown-trigger:focus,
      .dropdown-trigger:active {
        color: var(--navbar-link-color-hover);
        background: transparent;
      }

      .dropdown-menu {
        position: static;
        left: auto;
        width: 100%;
        background: transparent;
        box-shadow: none;
        border: none;
        visibility: visible;
        transform: none;
        padding: 0;
        margin: 0;
        border-radius: 0;
        display: block;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition:
          max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
          opacity 0.25s ease;
      }

      .nav-item.has-dropdown.active .dropdown-menu {
        max-height: 60vh;
        opacity: 1;
        transform: none;
      }

      .dropdown-item {
        border-bottom: 1px solid color-mix(in srgb, var(--navbar-border) 50%, transparent);
      }

      .dropdown-item:last-child {
        border-bottom: none;
      }

      .dropdown-link {
        padding: 1rem 1.5rem;
        font-size: 1rem;
        font-weight: 400;
        color: var(--text-muted);
        background: transparent;
        border-radius: 0;
        letter-spacing: -0.02em;
      }

      .dropdown-link:hover {
        background: transparent;
        color: var(--navbar-link-color-hover);
        transform: none;
      }

      body.menu-open {
        overflow: hidden;
        position: fixed;
        width: 100%;
        height: 100vh;
        height: 100dvh;
      }
    }

    @media (max-width: 480px) {
      .site-header .container {
        padding: 0 0.75rem;
      }

      .nav-links {
        padding: 0 1rem;
      }

      .nav-link {
        padding: var(--navbar-mobile-link-padding-narrow);
        font-size: 1.05rem;
      }

      .dropdown-link {
        padding: 0.875rem 1.25rem;
        font-size: 0.95rem;
      }
    }

    /* Current page's link. Declared after the mobile block so its `.nav-link:hover` reset
       (same specificity) cannot win. Defaults leave the link looking like any other. */
    .nav-link.active {
      color: var(--_navbar-link-active-color);
      background: var(--_navbar-link-active-bg);
    }

    /* Logo for a transparent menu over a dark top: hidden until the overlay state. */
    .brand-link .brand-logo--inverse {
      display: none;
    }

    /* Overlay: a page that renders an element with `data-navbar-overlay` (its blue hero or
       header band) lets the menu sit on top of it, transparent, with the light colors above.
       The header slides over the next element by its own height, so that element draws
       underneath and must pad its top by `--navbar-height` itself. Once the page scrolls
       (`.scrolled`) or the mobile panel is open (`body.menu-open`), the menu is solid again. */
    body:has([data-navbar-overlay]) .site-header {
      margin-bottom: calc(-1 * var(--navbar-height) - 1px);
    }

    body:not(.menu-open):has([data-navbar-overlay]) .site-header:not(.scrolled) {
      --_navbar-fg: var(--navbar-overlay-fg);
      --_navbar-link-color: var(--navbar-overlay-fg);
      --_navbar-link-color-hover: var(--navbar-overlay-fg);
      --_navbar-link-active-color: var(--navbar-overlay-fg);
      --_navbar-link-active-bg: var(--navbar-overlay-link-active-bg);

      background: transparent;
      border-bottom-color: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    body:not(.menu-open):has([data-navbar-overlay]) .site-header:not(.scrolled) .brand-logo {
      display: none;
    }

    body:not(.menu-open):has([data-navbar-overlay])
      .site-header:not(.scrolled)
      .brand-logo--inverse {
      display: block;
    }

    body:not(.menu-open):has([data-navbar-overlay])
      .site-header:not(.scrolled)
      .nav-item--button
      .button {
      --button-bg: var(--navbar-overlay-button-bg);
      --button-bg-hover: var(--navbar-overlay-button-bg-hover);
      --button-fg: var(--navbar-overlay-button-fg);
      --button-border: var(--navbar-overlay-button-border);
    }

    @media (prefers-reduced-motion: reduce) {
      .site-header,
      .nav-link,
      .dropdown-menu,
      .dropdown-link,
      .hamburger,
      .hamburger-line,
      .nav-container {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }
  }
</style>

<script>
  import "@walle/scripts/navbar.ts";
</script>
