---
import { Icon } from "astro-icon/components";
import type { BaseProps } from "../shared/types";
import { splitProps } from "../shared/attrs";
import { labeler } from "@walle/utils";
import { breadcrumbJsonLd } from "@walle/utils/structured-data";
import StructuredData from "./StructuredData.astro";
const label = labeler(Astro.currentLocale);

export interface BreadcrumbItem {
  /**
   * Label to display
   */
  label: string;

  /**
   * Destination URL
   */
  href?: string;

  /**
   * Icon name (optional)
   */
  icon?: string;
}

export interface Props extends BaseProps<"nav"> {
  /**
   * Array of breadcrumb items
   */
  items: BreadcrumbItem[];

  /**
   * Custom separator (default: chevron-right)
   */
  separator?: string;

  /**
   * Emit a schema.org BreadcrumbList next to the nav (default: true). The last item points
   * at the current page URL.
   */
  jsonLd?: boolean;
}

const OWN_KEYS = ["items", "separator", "class", "jsonLd"] as const;
const { own, rest } = splitProps(Astro.props, OWN_KEYS);
const { items = [], class: className, jsonLd = true } = own;
const ld =
  jsonLd && items.length ? breadcrumbJsonLd(items, Astro.url, Astro.site ?? Astro.url) : null;
---

{ld && <StructuredData data={ld} />}
<nav aria-label={label("breadcrumbs.nav")} class:list={["breadcrumbs", className]} {...rest}>
  <ol>
    {items.map((item, index) => (
      <li class={index === items.length - 1 ? "current" : ""}>
        {index > 0 && (
          <span class="separator" aria-hidden="true">
            {" "}
            /{" "}
          </span>
        )}

        {item.href && index !== items.length - 1 ? (
          <a href={item.href}>
            {item.icon && <Icon name={item.icon} class="item-icon" aria-hidden="true" />}
            <span>{item.label}</span>
          </a>
        ) : (
          <span class="current-item" aria-current={index === items.length - 1 ? "page" : undefined}>
            {item.icon && <Icon name={item.icon} class="item-icon" aria-hidden="true" />}
            <span>{item.label}</span>
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  @layer walle.components {
    .breadcrumbs {
      /* Public properties */
      --breadcrumbs-color: var(--primary);
      --breadcrumbs-color-hover: var(--primary-dark);
      --breadcrumbs-bg-hover: color-mix(in srgb, var(--primary) 5%, transparent);
      --breadcrumbs-current-color: var(--text-muted);
      --breadcrumbs-separator-color: color-mix(in srgb, var(--text-muted) 60%, transparent);

      margin-bottom: 1.5rem;
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    .breadcrumbs ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      list-style: none;
      padding: 0;
      margin: 0;
      gap: 0.2rem;
    }

    .breadcrumbs li {
      display: flex;
      align-items: center;
    }

    .breadcrumbs a {
      color: var(--breadcrumbs-color);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.4rem;
      border-radius: var(--radius-md);
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .breadcrumbs a:hover {
      background: var(--breadcrumbs-bg-hover);
      color: var(--breadcrumbs-color-hover);
    }

    .current-item {
      color: var(--breadcrumbs-current-color);
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.4rem;
      white-space: nowrap;
      min-width: 0;
    }

    /* Flex items default to min-width: auto, so text-overflow has no effect unless
           `min-width: 0` is set on both the <li> and the flex parent. */
    .breadcrumbs li {
      min-width: 0;
    }

    .current-item > span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .separator {
      color: var(--breadcrumbs-separator-color);
      display: flex;
      align-items: center;
      font-size: 0.7rem;
      margin: 0 0.2rem;
    }

    .item-icon {
      width: 0.9em;
      height: 0.9em;
    }

    @media (max-width: 640px) {
      .breadcrumbs {
        font-size: 0.85rem;
      }

      .breadcrumbs li:first-child {
        display: none;
      }

      .breadcrumbs li:first-child + li .separator {
        display: none;
      }

      /* `:not(:nth-child(2))`: in a two-item trail the current item is the only one
                 visible once Home is hidden. */
      .breadcrumbs li.current:not(:nth-child(2)) {
        display: none;
      }
    }

    @media (max-width: 380px) {
      .breadcrumbs a,
      .current-item {
        padding: 0.2rem;
      }
    }
  }
</style>
