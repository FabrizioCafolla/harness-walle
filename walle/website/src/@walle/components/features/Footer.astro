---
const today = new Date();
import type { FooterConfig, NavigationLink } from "@walle/config";
import config from "@walle/config";
import { label as t, resolveInternalUrl } from "@walle/utils";
import { Icon } from "astro-icon/components";
import { linkAttrs } from "../shared/attrs";

const footerConfig: FooterConfig = config.footer;
const footerItems = Array.isArray(footerConfig.items) ? footerConfig.items : [];
const navigationLinks = footerItems.filter((item: NavigationLink) => item.name);
const socialLinks = footerItems.filter((item: NavigationLink) => item.icon);

const hasLogo = footerConfig.logo?.src;
const hasTitle = footerConfig.logo?.title;
const shouldShowBrand = hasLogo || hasTitle;
---

<footer>
  <slot name="top" />
  <div class="footer-container">
    <div class="footer-section footer-left">
      <div class="copyright">
        {shouldShowBrand && (
          <a
            href={resolveInternalUrl(footerConfig.logo.url)}
            class={`brand-link ${footerConfig.logo.cssClasses || ""}`}
          >
            {hasLogo && (
              <img
                src={footerConfig.logo.src}
                alt={footerConfig.logo.alt || footerConfig.logo.title || t("logo")}
                aria-label={footerConfig.logo.alt || footerConfig.logo.title || t("logo")}
                width={footerConfig.logo.width || 32}
                height={footerConfig.logo.height || 32}
                class={footerConfig.logo.cssClasses || ""}
              />
            )}
            {hasTitle && (
              <span class={footerConfig.logo.cssClasses || ""}>{footerConfig.logo.title}</span>
            )}
          </a>
        )}
        <span class="license">
          {today.getFullYear()} &copy; {footerConfig.logo.license}
        </span>
      </div>
    </div>

    <div class="footer-section footer-center">
      <nav class="footer-nav" aria-label={t("footer.nav")}>
        <ul class="footer-nav__list">
          {navigationLinks.map((item: NavigationLink) => (
            <li>
              <a href={resolveInternalUrl(item.url)}>{item.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-section footer-right">
      <ul class="social-links" aria-label={t("footer.social")}>
        {socialLinks.map((item: NavigationLink) => (
          <li>
            <a
              href={item.url}
              {...linkAttrs({ external: true })}
              aria-label={item.icon?.replace("fa:", "")}
            >
              <Icon name={item.icon!} aria-hidden="true" size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  @layer walle.components {
    footer {
      /* Public properties. */
      --footer-bg: var(--gray);
      --footer-fg: var(--text-muted);
      --footer-link-color: var(--text-muted);
      --footer-link-color-hover: var(--primary);
      --footer-border: var(--gray);
      --footer-gap: 2rem;
      /* Share of the row taken by the link column, against 1 for logo and icons. */
      --footer-nav-grow: 1;
      --footer-underline: var(--primary);
      --footer-icon-bg: var(--surface-alt);
      --footer-icon-fg: var(--text-muted);
      --footer-icon-bg-hover: var(--primary);
      --footer-icon-fg-hover: var(--white);
      /* Wave edge on top of the footer, painted in `--footer-bg`; 0 = a straight edge. */
      --footer-wave-height: 0rem;

      position: relative;
      bottom: 0;
      margin-top: auto;
      padding: 1.75rem 2rem;
      background-color: var(--footer-bg);
      border-top: 1px solid var(--footer-border);
      color: var(--footer-fg);
      font-size: 0.9rem;
      z-index: 10;
    }

    footer::before {
      content: "";
      position: absolute;
      inset: auto 0 100% 0;
      height: var(--footer-wave-height);
      background: var(--footer-bg);
      --footer-wave: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 48' preserveAspectRatio='none'><path d='M0 48 H1440 V24 C1320 4 1200 4 1080 24 C960 44 840 44 720 24 C600 4 480 4 360 24 C240 44 120 44 0 24 Z'/></svg>");
      -webkit-mask: var(--footer-wave) center / 100% 100% no-repeat;
      mask: var(--footer-wave) center / 100% 100% no-repeat;
      pointer-events: none;
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    .footer-section {
      flex: 1;
    }

    .footer-left {
      text-align: left;
    }

    .footer-center {
      flex-grow: var(--footer-nav-grow);
      text-align: center;
    }

    .footer-right {
      text-align: right;
    }

    .copyright {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      font-family: var(--font-body);
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s ease;
    }

    .brand-link:hover {
      color: var(--footer-link-color-hover);
      transform: translateY(-1px);
    }

    .brand-link img {
      border-radius: var(--radius-md);
    }

    .license {
      font-size: 0.8rem;
    }

    .license a {
      color: var(--primary);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .license a:hover {
      text-decoration: underline;
    }

    .footer-nav__list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--footer-gap);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer-nav a {
      color: var(--footer-link-color);
      text-decoration: none;
      transition: color 0.2s ease;
      position: relative;
    }

    .footer-nav a:after {
      content: "";
      position: absolute;
      width: 0;
      height: 1px;
      bottom: -4px;
      left: 0;
      background-color: var(--footer-underline);
      transition: width 0.3s ease;
    }

    .footer-nav a:hover {
      color: var(--footer-link-color-hover);
    }

    .footer-nav a:hover:after {
      width: 100%;
    }

    .social-links {
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .social-links a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      /* Local property so the token-literal check sees a var() instead of a bare percentage. */
      --social-icon-radius: 50%;
      border-radius: var(--social-icon-radius);
      background-color: var(--footer-icon-bg);
      color: var(--footer-icon-fg);
      transition: all 0.2s ease;
    }

    .social-links a:hover {
      background-color: var(--footer-icon-bg-hover);
      color: var(--footer-icon-fg-hover);
      transform: translateY(-2px);
    }

    @media (max-width: 768px) {
      .footer-container {
        flex-direction: column;
        gap: 1.5rem;
      }

      .footer-left,
      .footer-center,
      .footer-right {
        text-align: center;
      }

      .copyright {
        align-items: center;
      }

      .social-links {
        justify-content: center;
      }
    }
  }
</style>
