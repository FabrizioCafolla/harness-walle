---
import Analytics from "@walle/components/features/Analytics.astro";
import Head from "@walle/components/features/Head.astro";
import StructuredData from "@walle/components/features/StructuredData.astro";
import config from "@walle/config";
import { mergeJsonLd, organizationJsonLd, websiteJsonLd } from "@walle/utils/structured-data";
import { label } from "@walle/utils";
import "@walle/styles/global.css";
// Generated theme tokens (overrides walle defaults, overridden by consumer global.css).
import "virtual:walle-theme.css";
import "@styles/global.css";

export type { AbstractLayoutProps as Props } from "./types";

const {
  headerTitle = "",
  headerDescription = config.app.website.description || "",
  headerImage = config.app.website.image || null,
  headerOgImage = null,
  headerEntryOgImage = null,
  headerRobots = config.app.website.robots || "index, follow",
  headerLanguage = config.app.website.language || "",
  headerPublishedTime = null,
  skipLinkLabel,
} = Astro.props;

// Footer icon links are the site's social profiles, listed as the Organization's `sameAs`.
const footerItems = Array.isArray(config.footer?.items) ? config.footer.items : [];
const sameAs = footerItems
  .filter((item) => item.icon && /^https?:\/\//.test(item.url))
  .map((item) => item.url);

const siteInfo = {
  title: config.app.website.title,
  description: config.app.website.description,
  url: Astro.site ? new URL(config.app.astro.basePath || "/", Astro.site).href : "",
  // The site's image, not the page's: a post image must not become the Organization logo.
  image: config.app.website.image ? new URL(config.app.website.image, Astro.site).href : undefined,
  sameAs,
};
const structuredData = config.app.website.structuredData;
---

<!doctype html>
<html lang={headerLanguage}>
  <head>
    <Head
      title={headerTitle}
      description={headerDescription}
      image={headerImage}
      ogImage={headerOgImage}
      entryOgImage={headerEntryOgImage}
      robots={headerRobots}
      publishedTime={headerPublishedTime}
    />
    <StructuredData
      data={[
        mergeJsonLd(websiteJsonLd(siteInfo), structuredData?.website),
        mergeJsonLd(organizationJsonLd(siteInfo), structuredData?.organization),
      ]}
    />
    <slot name="head" />
  </head>
  <body data-label-scrollable={label("scrollableRegion")}>
    <a href="#main-content" class="skip-link">{label("skipLink", skipLinkLabel)}</a>
    <slot />
    <Analytics
      enable={config.env.IS_PRODUCTION || false}
      scriptContent={config.app.astro.analyticsScriptContent || ""}
    />
    <script>
      // A scrollable region must be keyboard-reachable (WCAG 2.1.1 / axe
      // `scrollable-region-focusable`); only overflowing ones without focusable content get a tab stop.
      function makeScrollRegionsFocusable() {
        const focusable = "a[href],button,input,select,textarea,[tabindex]";
        const candidates = document.querySelectorAll<HTMLElement>("pre,table,[data-scrollable]");
        if (candidates.length === 0) return;
        // Reads first, writes after: interleaving them forces a re-layout per element.
        const needsFocus: HTMLElement[] = [];
        candidates.forEach((el) => {
          if (el.hasAttribute("tabindex")) return;
          const overflows = el.scrollWidth > el.clientWidth || el.scrollHeight > el.clientHeight;
          if (overflows && !el.querySelector(focusable)) needsFocus.push(el);
        });
        needsFocus.forEach((el) => {
          el.setAttribute("tabindex", "0");
          el.setAttribute("role", "region");
          const name = document.body.dataset.labelScrollable;
          if (name && !el.hasAttribute("aria-label")) el.setAttribute("aria-label", name);
        });
      }
      const scheduleScrollRegions = () => requestAnimationFrame(makeScrollRegionsFocusable);
      document.addEventListener("DOMContentLoaded", scheduleScrollRegions);
      document.addEventListener("astro:page-load", scheduleScrollRegions);
    </script>
  </body>
</html>
